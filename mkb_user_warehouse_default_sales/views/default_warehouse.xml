<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherit Form View to Modify it -->
    <record id="mkb_view_users_inherit_form" model="ir.ui.view">
        <field name="name">mkb.res.users.inherit.form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="after">
                <page name="mkb_user_warehouse" string="Warehouse Configuration">
                    <group>
                        <group>
                            <field name="is_wr_so"/>
                        </group>
                        <group>
                            <field name="default_wr"
                                   attrs="{'invisible':[('is_wr_so', '=' , False)],'required':[('is_wr_so', '!=' , False)]}"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>